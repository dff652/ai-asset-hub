{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-asset-hub.local/spec/migration-readiness.schema.json",
  "title": "AI Asset Hub Migration Readiness Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "producedBy",
    "ok",
    "level",
    "subject",
    "packageReadiness",
    "migrationPreflight",
    "backupEvidence",
    "restoreExercise",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "migration-readiness"
    },
    "producedBy": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "level": {
      "enum": ["blocked", "attention", "ready"]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "packageReadiness": {
      "$ref": "#/$defs/packageReadiness"
    },
    "migrationPreflight": {
      "$ref": "#/$defs/migrationPreflight"
    },
    "backupEvidence": {
      "$ref": "#/$defs/backupEvidence"
    },
    "restoreExercise": {
      "$ref": "#/$defs/restoreExercise"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "selectionSHA256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "packageReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assetCount", "fileCount"],
      "properties": {
        "status": {
          "enum": ["ready", "blocked"]
        },
        "assetCount": {
          "type": "integer",
          "minimum": 0
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "migrationPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "targets",
        "unsupportedTargets",
        "droppedItems",
        "degradedItems",
        "secretReferences",
        "missingSecrets",
        "devicePrivateItems"
      ],
      "properties": {
        "status": {
          "enum": ["ready", "attention", "blocked"]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "unsupportedTargets": {
          "type": "integer",
          "minimum": 0
        },
        "droppedItems": {
          "type": "integer",
          "minimum": 0
        },
        "degradedItems": {
          "type": "integer",
          "minimum": 0
        },
        "secretReferences": {
          "type": "integer",
          "minimum": 0
        },
        "missingSecrets": {
          "type": "integer",
          "minimum": 0
        },
        "devicePrivateItems": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "backupEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["missing", "recorded", "mismatch", "invalid", "unchecked"]
        },
        "type": {
          "enum": ["git-commit", "snapshot", "object", "offline-media"]
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "referenceDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{12}$"
        }
      }
    },
    "restoreExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "targets"],
      "properties": {
        "status": {
          "enum": ["missing", "passed", "failed", "mismatch", "invalid", "unchecked"]
        },
        "packageSHA256": {
          "$ref": "#/$defs/sha256"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "producedBy": {
          "type": "string",
          "minLength": 1
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "paths"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
